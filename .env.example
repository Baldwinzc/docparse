# 复制为 .env 后填写。
# 本地优先，云端默认关（#94）：下面两处云端端点都留空时，进程不发任何外部请求；
# 要外呼必须显式填。约束口径见 CLAUDE.md「已对齐的产品约束」。

# 云端外呼硬闸（#100）。默认 false —— 下方的云 OCR（TextIn）与云 LLM 连请求都不
# 构造，**填了密钥也不外发**。要外呼必须把它显式改 true，这一步是刻意的。
# 管的是「有没有显式开闸」，不看端点地址：内网端点（#101）同样要开闸。
DOCPARSE_ALLOW_CLOUD=false

# LLM 端点档位（#101）。默认 local：内网可起的 OpenAI 兼容服务（vLLM / Ollama）。
# 两档同一套协议、同一个硬闸——**两档都要开 DOCPARSE_ALLOW_CLOUD 才发请求**。
DOCPARSE_LLM_ENGINE=local

# 本地档（llm_engine=local）：内网 vLLM / Ollama 的 OpenAI 兼容口。
# 本地端点通常不鉴权，KEY 可留空；Ollama 要求非空但忽略内容，填任意串即可。
DOCPARSE_LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
DOCPARSE_LLM_LOCAL_MODEL=qwen3:4b
DOCPARSE_LLM_LOCAL_API_KEY=

# 云端档（llm_engine=cloud）：云端 OpenAI 兼容口，必须配 KEY 才发请求。
DOCPARSE_LLM_BASE_URL=https://api.openai.com/v1
DOCPARSE_LLM_API_KEY=
DOCPARSE_LLM_MODEL=gpt-4.1-mini
DOCPARSE_VLM_MODEL=gpt-4.1-mini

# 扫描件 OCR 引擎（#99）。默认 local：PaddleOCR PP-OCRv6 small + doc-ori 方向分类
# （#110 选型），纯内网，不出网。只有选 textin 才会用到下面的云端点。
# device：auto（有 CUDA 用 gpu，否则 cpu）/ cpu / gpu；cpu_threads 留空用官方默认。
DOCPARSE_OCR_ENGINE=local
DOCPARSE_LOCAL_OCR_DEVICE=auto
# 留空即不设置（不要写 =），用 PaddleOCR 官方默认线程数
# DOCPARSE_LOCAL_OCR_CPU_THREADS=10

# 合合 TextIn 云 OCR（扫描件 PDF / 图片，#22）。要它真正发请求，得同时满足：
# OCR_ENGINE=textin **且** ALLOW_CLOUD=true。缺密钥或没开闸都只登记告警、
# 文档进 needs_review，流水线不崩，也不外呼（硬闸见 #100）。
DOCPARSE_TEXTIN_APP_ID=
DOCPARSE_TEXTIN_SECRET_CODE=

# 任务与文件目前走内存实现；换成 postgres / s3 时只改这两个值
DOCPARSE_JOB_STORE=memory
DOCPARSE_FILE_STORE=memory

DOCPARSE_MAX_UPLOAD_MB=100
DOCPARSE_MAX_ARCHIVE_FILES=200
DOCPARSE_MAX_ARCHIVE_DEPTH=3
